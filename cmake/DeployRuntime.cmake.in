execute_process(
    COMMAND "@VELLUM_WINDEPLOYQT@" --release --no-translations --no-opengl-sw
        --no-plugins --skip-plugin-types generic,networkinformation,tls --no-network
        "${CMAKE_INSTALL_PREFIX}/Vellum.exe"
    COMMAND_ERROR_IS_FATAL ANY
)
file(INSTALL "@VELLUM_QT_PLUGINS@/platforms/qwindows.dll"
    DESTINATION "${CMAKE_INSTALL_PREFIX}/platforms")

function(vellum_verify_deployed name relative_path expected_sha256)
    set(path "${CMAKE_INSTALL_PREFIX}/${relative_path}")
    if(NOT EXISTS "${path}")
        message(FATAL_ERROR "${name} was not deployed: ${path}")
    endif()
    file(SHA256 "${path}" actual_sha256)
    if(NOT actual_sha256 STREQUAL expected_sha256)
        message(FATAL_ERROR "${name} changed during deployment: ${actual_sha256}")
    endif()
endfunction()

vellum_verify_deployed("Qt 6 Core" "Qt6Core.dll" "b712b4754588e89f855dc0aa087d6304b2fd21b0e0639d1cdeb9cb969bd5fb72")
vellum_verify_deployed("Qt 6 GUI" "Qt6Gui.dll" "03ba47a2025036a04f5548bce242788ac21edf551e78d5b42e1b87beb799904f")
