execute_process(
    COMMAND "@VELLUM_WINDEPLOYQT@" --release --no-translations --no-opengl-sw
        --no-plugins --skip-plugin-types generic,networkinformation,tls --no-network
        "${CMAKE_INSTALL_PREFIX}/Vellum.exe"
    COMMAND_ERROR_IS_FATAL ANY
)
file(INSTALL "@VELLUM_QT_PLUGINS@/platforms/qwindows.dll"
    "@VELLUM_QT_PLUGINS@/platforms/qoffscreen.dll"
    DESTINATION "${CMAKE_INSTALL_PREFIX}/platforms")
